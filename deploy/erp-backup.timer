# Nightly trigger for erp-backup.service (Roadmap E2). Install: see DEPLOY.md.

[Unit]
Description=Nightly ERP database backup

[Timer]
# Every day at 02:00 server time.
OnCalendar=*-*-* 02:00:00
# If the machine was off at 02:00, run the backup on next boot.
Persistent=true

[Install]
WantedBy=timers.target
